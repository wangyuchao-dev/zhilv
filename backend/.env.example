# ============================================================
# 复制这个文件为 .env，然后填上你自己的值
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env 已经被 .gitignore 排除，不会提交
# ============================================================

# ---------- 大模型 ----------
# 阿里云百炼控制台 → API-KEY 管理 → 创建，格式类似 sk-xxxxxxxx
LLM_API_KEY=这里填你的 Key
CHAT_MODEL=qwen-flash
EMBEDDING_MODEL=text-embedding-v4

# ---------- PostgreSQL ----------
# 建库：CREATE DATABASE zhilv;
# 没有 PG 可以先用 SQLite：sqlite:///./db/zhilv.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/zhilv

# ---------- Redis ----------
# 留空则自动退化为进程内内存缓存
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 向量库 ----------
CHROMA_DB_DIR=db/chroma_db
CHROMA_COLLECTION_NAME=travel_guides

# ---------- 检索 ----------
# 相关性阈值，基于 text-embedding-v4 + 当前 7 城语料实测；换模型/加城市要重测
MIN_SCORE=0.80
MIN_SCORE_FALLBACK=0.79
RETRIEVAL_TOP_K=6
MAX_INFLIGHT=2
